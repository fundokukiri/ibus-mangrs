# Bỏ qua thư mục build của Rust
/target/
**/target/

# Bỏ qua file backup của rustfmt
**/*.rs.bk
*.pdb

# File cấu hình cá nhân — không công khai
.claude/
CLAUDE.md
AGENTS.md
.vscode/
.idea/
.DS_Store

# Tài liệu làm việc nội bộ — không công khai (các file hiện tại, file mới sau này vẫn được push)
.gitignore
/ARCHITECTURE.md
/NOTICE.md

# Tài liệu nội bộ — không push lên repo công khai
/docs/

# Công cụ kiểm thử nội bộ — không push lên repo công khai
/test/

# Scripts cài đặt nội bộ — không push lên repo công khai (trừ install-online.sh)
/scripts/autoinstall.sh
/scripts/dist.sh
/scripts/install_1.sh
/scripts/release.sh
/CHAT.md
/TODO.md
/DEVLOG.md
/docs/install.md
/docs/modes.md
/docs/open-questions.md
/docs/settings.md
/docs/troubleshooting.md
__pycache__/
/test/logs/
/test/perf-results.jsonl
/CHAT.md
/test/expected-gen/target/
/analysis/

# packaging build artifacts (local)
/dist/

# Internal audit reports — not pushed to public repo
/audit/

# Git submodule metadata — not pushed to public repo
/.gitmodules
/packaging/arch/src/
/packaging/arch/pkg/
/packaging/arch/*.tar.gz
/packaging/arch/*.pkg.tar.zst
